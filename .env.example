# Variables para docker compose (copia este archivo a .env y rellena APP_KEY).
# No subas el .env real al repo.

# Clave de la app. Genera una con: docker compose run --rm app php artisan key:generate --show
APP_KEY=

# URL publica por la que se accedera (IP o dominio del VPS)
APP_URL=http://localhost

# Claves de MySQL (cambialas por algo seguro)
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_PASSWORD=cambia_esta_clave
